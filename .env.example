# ==============================================================================
# Examify System Environment Configuration
# ==============================================================================

# Node Environment & Debugging
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set DEBUG=true to enable verbose Prisma query logs, Redis connection debug, and AI rotation logs
DEBUG=false

# ------------------------------------------------------------------------------
# Database (MariaDB / MySQL via Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://examify_user:examify_password@localhost:3306/examify_db"

# ------------------------------------------------------------------------------
# Cache & Queue (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_encryption_key_change_me_in_production_min_32_chars
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# Storage Paths
# ------------------------------------------------------------------------------
STORAGE_EXAMS_PATH="./storage/exams"
STORAGE_LOGS_PATH="./storage/logs"

# ------------------------------------------------------------------------------
# AI Providers Configuration (Multi-Token & Multi-Model Auto-Fallback)
# ------------------------------------------------------------------------------
# Default AI Provider: gemini | openai | self-hosted
DEFAULT_AI_PROVIDER=gemini

# 1. Google Gemini (Supports multiple keys separated by comma & fallback models list)
# e.g., GEMINI_API_KEY="AIzaKey1, AIzaKey2, AIzaKey3"
GEMINI_API_KEY=AIzaSyYourGeminiApiKey
# e.g., GEMINI_MODEL="gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash"
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenAI (Supports multiple keys separated by comma & fallback models list)
# e.g., OPENAI_API_KEY="sk-key1, sk-key2"
OPENAI_API_KEY=sk-proj-your-openai-api-key
# e.g., OPENAI_MODEL="gpt-4o-mini, gpt-4o, gpt-3.5-turbo"
OPENAI_MODEL=gpt-4o-mini

# 3. Anthropic Claude (Supports multiple keys separated by comma & fallback models list)
CLAUDE_API_KEY=sk-ant-api03-your-claude-api-key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 4. Self-Hosted (vLLM / Ollama / LocalAI - OpenAI-compatible endpoint)
SELF_HOSTED_AI_BASE_URL=http://localhost:11434/v1
SELF_HOSTED_AI_API_KEY=ollama
SELF_HOSTED_AI_MODEL=llama3:8b

